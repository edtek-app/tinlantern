# The +psycopg suffix is required: this project installs psycopg v3, and a
# bare postgresql:// URL makes SQLAlchemy look for psycopg2 instead.
DATABASE_URL=postgresql+psycopg://tinlantern:tinlantern@localhost:5432/tinlantern
# anthropic = local dev | stub = deterministic canned responses for tests/CI
# (no key needed) | bedrock = deployed environments, set via infra config
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=              # required when LLM_PROVIDER=anthropic
AWS_REGION=us-east-1            # only used when LLM_PROVIDER=bedrock (M6+)
# DEMO_MODE OVERRIDES LLM_PROVIDER. With it on, the stub serves recorded
# responses and no model is ever called — a public demo that can spend
# money or exercise a credential is a liability. `GET /health` reports
# which provider actually won, so the override is checkable from outside
# the process.
DEMO_MODE=true
